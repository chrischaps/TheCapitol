/target/
/renders/
# The /terrain disk cache (crates/capitol-client/src/terrain.rs)
/cache/
# The binary client pins its lockfile, seeded from engine/Cargo.lock so it
# resolves to the versions Flint is tested with.
!Cargo.lock
# The engine's script store and the session file (server, email and
# token: never commit it), crates/capitol-client/src/session.rs
/save/
# capitol-town's roster holds its citizens' keys, and its health (C1.1) and
# who was where in their day (C1.2).
# town.example.toml shows the shape.
/town.toml
/town.status
/town.presence.csv
/town.report-key
# Every key the town has run, to settle a citizen dropped from it (#585)
/town.known.json
/town.stints.json
/keys/
/town.decisions/
/town.corpus/
# A soak's roster, keys and reports (C1.7b, #306)
/soak/
# scripts/town.sh's town: its roster, keys, admin and the server's log (#337)
/town/
# scripts/balance.ps1's runs: two towns' rosters, logs, soaks and the comparison (D6.3)
/balance/
# The sounds, written at start by crates/capitol-client/src/sound/library.rs
/audio/*.wav
/audio/.synth-version
