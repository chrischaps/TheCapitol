DATABASE_URL=postgres://capitol:capitol_dev@localhost:5433/capitol
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-secret-key-change-in-production
HOST=0.0.0.0
PORT=3000
# Token lifetimes for clients that ask for a refresh token (E0.6)
ACCESS_TTL_SECS=900
REFRESH_TTL_SECS=2592000

# Rate limits (E0.7, backend/src/rate_limit.rs), per minute. These are the
# defaults. A local capitol-bot swarm logs every bot in from one address, so
# raise the auth limit for it (RATE_LIMIT_AUTH_PER_MIN=1000), or turn the
# limits off altogether with RATE_LIMITS=off. A debug build already lets
# loopback (127.0.0.1, ::1) sign in 1000 times a minute, so the live test
# suites and a small swarm on this machine don't trip it (#239); a release
# build counts loopback like anyone else unless the loopback limit is set.
# RATE_LIMITS=on
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_LOOPBACK_AUTH_PER_MIN=1000
# RATE_LIMIT_READ_PER_MIN=120
# RATE_LIMIT_WORLD_PER_MIN=60
# RATE_LIMIT_INVENTORY_PER_MIN=120
# RATE_LIMIT_MARKET_PER_MIN=30
# RATE_LIMIT_WS_PER_MIN=60
# Lines of talk and letters, per account, in 10 s (S0.1):
# RATE_LIMIT_CHAT_PER_10S=8
# Steers, per connection (controls T0.3): a burst, then a second:
# RATE_LIMIT_STEER_BURST=30
# RATE_LIMIT_STEER_PER_SEC=15

# Mock subscriptions (E4.1): players may start their own with
# POST /player/subscription, as capitol-bot --subscribe does. On by default
# in debug builds, off in release ones.
# MOCK_SUBSCRIPTIONS=on

# Grants (E3.8): players may give themselves Strands and goods with
# POST /player/grant, to fund capitol-bot --market and the sim's market
# makers. Off unless set, in every build: never on a shared server.
# DEV_GRANTS=on

# The economy sim's time multiplier (E2.7): the tick runs this many times
# real time, so `capitol-bot --sim 20 --hours 2` takes 12 minutes at 10.
# Debug builds only, 1 to 100. Run the sim with RATE_LIMITS=off too.
# SIM_TICK_SCALE=1

# Slow work (D3.2): a database statement that takes this long or longer is
# logged as a warning and counted against the tick's phase, or the loop, it
# ran in (GET /admin/ledger). 50 unless set.
# SLOW_STATEMENT_MS=50
# The Observatory's sampler (D0.2): seconds between samples, 10 unless
# set. 0 turns it off, to measure what it costs the tick.
# METRICS_SAMPLE_SECS=10
